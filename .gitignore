# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local claude settings
.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated assets
/pdf_pages

.vercel

# Large PDF reference files
public/*.pdf

# API probing artifacts (local debugging only)
/*.html
/*.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/next.config.*.json
/lofin_*.js
/lofin_*.html
/eduinfo_*
/datago_*
/narasal_*
/btl.json
/debt_all.json
/scripts/output/
/lofin_meta.xlsx
scripts/_regions.json
data/
# 위 `data/` 패턴은 깊이에 상관없이 이름이 data인 모든 디렉터리를 무시한다
# (원자료 폴더 /data/ 뿐 아니라 src/lib/data/, src/lib/programs/data/까지).
# 그래서 소스 안의 data 디렉터리는 하나씩 개별로 되살린다. 여기에 없는 소스 data
# 디렉터리를 새로 만들면 git이 조용히 무시하므로 이 목록에 같이 추가할 것.
!/src/lib/data/
!/src/lib/programs/data/
